        "\n",
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "\n",
        "#forループで水～冥の9行を表示\n",
        "\n",
        "for i in array:\n",
        "  print(i)\n",
        "\n",
        "#whileループで水～冥の9行を表示\n",
        "\n",
        "i = 0\n",
        "\n",
        "while i <= 8:\n",
        "  print(array[i])\n",
        "  i = i + 1"
